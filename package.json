  "description": "MCP server for DoraHacks: find hackathons, read tracks, prizes, rules, deadlines and BUIDLs from your AI agent.",
  "type": "module",
  "bin": {
    "dorahacks-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
